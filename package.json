{
  "name": "starte",
  "version": "v0.5.7",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "chcp 65001 > nul && vite",
    "build": "chcp 65001 > nul && vite build",
    "packager": "electron-builder build"
  },
  "author": "zestela.co",
  "build": {
    "productName": "观星记 Starte",
    "appId": "com.zestela.starte",
    "copyright": "Zestela",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/icons/**/*",
      "src/HarmonyOS_Sans_SC/**/*",
      "packages/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build"
    },
    "nsis": {
      "oneClick": false,
      "language": "2052",
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "./src/icons/dock.ico",
      "uninstallerIcon": "./src/icons/dock.ico",
      "installerHeaderIcon": "./src/icons/dock.ico",
      "shortcutName": "观星记 Starte"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://starteupdate.oss-cn-beijing.aliyuncs.com/updates/"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "release-notes.md"
    },
    "win": {
      "icon": "./src/icons/dock.ico",
      "target": [
        {
          "target": "nsis"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "node-machine-id": "^1.1.12",
    "public-ip": "^8.0.0",
    "wallpaper": "^7.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "pinia": "^3.0.4",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "vue-demi"
    ]
  }
}
