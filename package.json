{
  "name": "starte",
  "version": "v0.5.1",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "packager": "electron-builder build"
  },
  "author": "zestela.co",
  "build": {
    "productName": "观星记 Starte",
    "appId": "com.zestela.starte",
    "copyright": "Zestela",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/popup.html",
      "src/icons/**/*",
      "src/HarmonyOS_Sans_SC/**/*",
      "packages/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build"
    },
    "nsis": {
      "oneClick": false,
      "language": "2052",
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "./src/icons/dock.ico",
      "uninstallerIcon": "./src/icons/dock.ico",
      "installerHeaderIcon": "./src/icons/dock.ico",
      "shortcutName": "观星记 Starte"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.zestela.co/"
      }
    ],
    "win": {
      "icon": "./src/icons/dock.ico",
      "target": [
        {
          "target": "nsis"
        }
      ]
    }
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "node-machine-id": "^1.1.12",
    "wallpaper": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "autoprefixer": "^10.5.0",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "pinia": "^2.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "vue-demi"
    ]
  }
}
